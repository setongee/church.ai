# Server
PORT=5050
FRONTEND_ORIGIN=http://localhost:3000

# Login
# A device that has been idle this long stops blocking a new login (each user can only be signed in on one device).
AUTH_IDLE_HOURS=12

# Email (roster assignments are emailed to the team). On Railway use Resend (HTTPS; SMTP is blocked there):
# set RESEND_API_KEY and MAIL_FROM on a domain verified in Resend. Elsewhere any SMTP provider works.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FAFC Media <media@yourchurch.org>"

# SMS (MultiTexter.com) - roster assignments are texted to team members with a phone number.
MULTITEXTER_API_KEY=
MULTITEXTER_SENDER_NAME=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/live-transcription

# Deepgram (live speech-to-text streaming)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenRouter (LLM refinement: quotes, key points, topics, scriptures, proclamations)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Cheap + fast model for real-time quote refinement / structured extraction.
# Swap for any OpenRouter model slug: https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Model used by the image editor's AI image generation (OpenRouter Image API).
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=FAFC Media Engine

# Instagram Graph API (publish exported quote images to Instagram)
# One-time setup (Instagram API with Instagram Login - no Facebook Page needed):
#   1. Your Instagram account must be a Professional (Business or Creator) account.
#   2. In your Meta app, add the Instagram product -> "API setup with Instagram login", add your
#      account as a tester/connected account, and generate a token.
#   3. Run `npm run ig:token -- <token>` - it saves INSTAGRAM_ACCESS_TOKEN and
#      INSTAGRAM_BUSINESS_ACCOUNT_ID for you. Renew every ~50 days with `npm run ig:token`.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Only used by `npm run ig:token` (Meta dashboard -> Instagram -> API setup with Instagram login).
INSTAGRAM_APP_SECRET=
# Must be a publicly reachable URL (deployed backend, or an ngrok/tunnel URL in dev) - Instagram
# fetches the exported image itself, so it can't be localhost.
PUBLIC_BASE_URL=
# Optional: URL Instagram uses to fetch media when it differs from PUBLIC_BASE_URL (e.g. an ngrok URL
# in dev while PUBLIC_BASE_URL stays empty/localhost). Falls back to PUBLIC_BASE_URL.
INSTAGRAM_PUBLIC_BASE_URL=

# Cloudinary is optional for the image editor: without credentials, editor images (uploads,
# exports, AI-generated) fall back to local files under backend/uploads served at /uploads.
# Cloudinary (stores an mp3 recording of each session once streaming stops)
# Dashboard: https://console.cloudinary.com/ -> Cloud name / API Key / API Secret are on the home page.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
