# Server
PORT=5050
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/live-transcription

# Deepgram (live speech-to-text streaming)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenRouter (LLM refinement: quotes, key points, topics, scriptures, proclamations)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Cheap + fast model for real-time quote refinement / structured extraction.
# Swap for any OpenRouter model slug: https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Live Transcription Quotes

# Instagram Graph API (publish exported quote images to Instagram)
# One-time setup:
#   1. Your Instagram account must be a Business or Creator account, linked to a Facebook Page.
#   2. Create a Meta developer app at https://developers.facebook.com/apps, add the
#      "Instagram Graph API" product, and connect that Page.
#   3. Generate a long-lived Page/IG access token (Graph API Explorer -> exchange for a
#      long-lived token) with instagram_basic + instagram_content_publish permissions.
#   4. INSTAGRAM_BUSINESS_ACCOUNT_ID is the IG *user* id (GET /{page-id}?fields=instagram_business_account).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Must be a publicly reachable URL (deployed backend, or an ngrok/tunnel URL in dev) - Instagram
# fetches the exported image itself, so it can't be localhost.
PUBLIC_BASE_URL=

# Cloudinary (stores an mp3 recording of each session once streaming stops)
# Dashboard: https://console.cloudinary.com/ -> Cloud name / API Key / API Secret are on the home page.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
